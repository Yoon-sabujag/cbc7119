{
  "permissions": {
    "deny": [
      "Bash(wrangler:*)",
      "Bash(npx wrangler:*)",
      "Bash(npm run deploy:*)",
      "Bash(npm run deploy)",
      "Bash(pnpm run deploy:*)",
      "Bash(yarn deploy:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/auto-push.sh"
          }
        ]
      }
    ]
  }
}
